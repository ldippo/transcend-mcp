{
  "name": "transcend",
  "version": "0.1.0",
  "description": "Code-intelligence MCP server: static map (tree-sitter) + live navigation (LSP) with a bridge between them",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "transcend": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "test": "vitest run",
    "smoke": "npm run build && node dist/test/smoke.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-metrics": "^2.4.0",
    "ignore": "^7.0.4",
    "tree-sitter-wasms": "^0.1.12",
    "vscode-jsonrpc": "^9.0.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-uri": "^3.1.0",
    "web-tree-sitter": "^0.25.4",
    "which": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/which": "^3.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
